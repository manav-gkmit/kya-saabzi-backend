# Copy to `.env` (do not commit real secrets).
# Used by `docker-compose.yml` and by local runs.

# --- App ---
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://kyasaabzi:change-me@localhost:5432/kyasaabzi
CORS_ORIGINS=["http://localhost:3000"]
DEBUG=false

# --- Docker/Compose ---
POSTGRES_DB=kyasaabzi
POSTGRES_USER=kyasaabzi
POSTGRES_PASSWORD=change-me

# --- Startup toggles ---
DB_WAIT_TIMEOUT=60
RUN_MIGRATIONS=1
RUN_SEEDERS=1
SEEDER_FORCE_PASSWORD=0
